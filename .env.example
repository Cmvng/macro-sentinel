# Copy this file to .env.local for local development. Do not commit .env.local.
# Configure the same values in Vercel for Production and Preview.

# Required server-only provider credential. Never use a VITE_ prefix.
ANTHROPIC_API_KEY=

# Required to authorize Vercel's scheduled GET /api/refresh request.
# Generate a long random value; do not expose it to the browser.
CRON_SECRET=

# Optional migration compatibility: do not add VITE_ANTHROPIC_KEY here.
# The server currently supports an existing Vercel VITE_ANTHROPIC_KEY only
# to prevent downtime while ANTHROPIC_API_KEY is added. Remove that legacy
# variable from Vercel after a successful server-only deployment.

# Relative FX scoring. When set to 1, the eight currencies are scored once and
# all 28 pairs are derived from the differentials, instead of scoring 28 pairs
# as independent instruments. Off by default.
MACROSENTINEL_RELATIVE_FX=
