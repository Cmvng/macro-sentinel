# Server-side only. No VITE_ prefix: Vite inlines VITE_* variables into the
# public browser bundle, which is how the Anthropic key was previously leaked.
ANTHROPIC_API_KEY=sk-ant-...

# Required for the /admin panel and for any forced (paid) rebuild.
# Privileged actions fail closed when this is unset.
ADMIN_SECRET=

# Set this in Vercel to let the scheduled cron force a full rebuild.
CRON_SECRET=

# Set to 1 to restore the pre-upgrade brief selection. Off by default.
MACROSENTINEL_LEGACY_BRIEF=
